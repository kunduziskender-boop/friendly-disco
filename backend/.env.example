# JWT — обязательно задайте SECRET_KEY (подпись токенов). В коде нет значения по умолчанию.
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (путь к файлу БД относительно каталога backend или абсолютный)
# DB_PATH=crm.db

# App
APP_TITLE=Lawyer CRM API
APP_VERSION=1.0.0
DEBUG=true

# ──────────────────────────────────────────────────────────────────
# Логирование
#   Возможные значения LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────
# Sentry (мониторинг ошибок бэкенда; опционально)
#   DSN возьмите в Sentry → Project Settings → Client Keys → DSN
# ──────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=

# ──────────────────────────────────────────────────────────────────
# Демо-сидирование пустой БД (admin@ / lawyer@ / assistant@ и test@ для e2e)
#   Не задавайте эти пароли в продакшене; для первого локального запуска см. README.
# ──────────────────────────────────────────────────────────────────
SEED_DEMO_ADMIN_PASSWORD=Admin1234
SEED_DEMO_LAWYER_PASSWORD=Lawyer1234
SEED_DEMO_ASSISTANT_PASSWORD=Assist1234
E2E_TEST_USER_PASSWORD=password123

# ──────────────────────────────────────────────────────────────────
# Telegram (уведомления о новых заявках с сайта)
#   1. Создайте бота у @BotFather, скопируйте токен.
#   2. Добавьте бота в чат/группу менеджеров и узнайте chat_id.
#   3. Если несколько чатов — TELEGRAM_CHAT_IDS через запятую.
#   Пустые значения = интеграция отключена, лиды всё равно сохраняются.
# ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ──────────────────────────────────────────────────────────────────
# Google Sheets (зеркало заявок в таблице для менеджера)
#   1. В Google Cloud создайте сервисный аккаунт и скачайте JSON-ключ.
#   2. Включите Google Sheets API в проекте.
#   3. Расшарьте таблицу на client_email из JSON (роль «Редактор»).
#   4. GOOGLE_SHEETS_SPREADSHEET_ID — id таблицы из URL.
#   Пустые значения = интеграция отключена, лиды всё равно сохраняются.
# ──────────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A:H

# Copy this file to .env and edit values locally.
