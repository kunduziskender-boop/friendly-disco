# JWT — обязательно смените SECRET_KEY в продакшене (подпись access-токенов)
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (путь к файлу БД относительно каталога backend или абсолютный)
# DB_PATH=crm.db

# App
APP_TITLE=Lawyer CRM API
APP_VERSION=1.0.0
DEBUG=true

# Copy this file to .env and edit values locally.
