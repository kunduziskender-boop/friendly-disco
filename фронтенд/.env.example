# Фронтенд (Vite). Скопируйте в `.env` при необходимости.
#
# Полная база REST (без хвостового /). Обязательно с http:// или https:// — иначе браузер
# воспримет строку как относительный путь к pages.dev и login даст 404.
# Локально (порт по умолчанию run-dev.ps1):
#   VITE_API_ROOT=http://127.0.0.1:8010/api
# Облако (Render и т.п.):
#   VITE_API_ROOT=https://ваш-сервис.onrender.com/api
#
# Старый бэкенд без префикса /api (нет регистрации — не рекомендуется):
#   VITE_API_ROOT=http://127.0.0.1:8000
#
# Альтернатива: корень сервера и флаг legacy
# VITE_API_BASE=http://127.0.0.1:8000
# VITE_API_LEGACY=true
